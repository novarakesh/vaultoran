# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas URI)
# Format: mongodb+srv://<username>:<password>@cluster0.fwiux9k.mongodb.net/trustvault?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.fwiux9k.mongodb.net/trustvault?retryWrites=true&w=majority

# JWT Authentication
# Generate a strong 256-bit or 512-bit secret for production
JWT_SECRET=super_secret_high_entropy_jwt_key_trustvault_2026_secure
JWT_EXPIRES_IN=24h

# File Storage Configuration
# Path to secured document vault (outside web root)
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=15

# Security & CORS Origin (Frontend URL or comma-separated list)
CORS_ORIGIN=http://localhost:5173,https://trustvault.onrender.com

# Seed Script Credentials
SEED_ADMIN_EMAIL=admin@trustvault.io
SEED_ADMIN_PASSWORD=AdminVault#2026!
SEED_OWNER_EMAIL=owner@trustvault.io
SEED_OWNER_PASSWORD=OwnerVault#2026!
SEED_VIEWER1_EMAIL=viewer1@trustvault.io
SEED_VIEWER1_PASSWORD=Viewer1Vault#2026!
SEED_VIEWER2_EMAIL=viewer2@trustvault.io
SEED_VIEWER2_PASSWORD=Viewer2Vault#2026!
